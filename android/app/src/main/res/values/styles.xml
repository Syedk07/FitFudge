<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        FitFudge launch theme — shown while the Flutter engine initialises.
        Background matches the app's #110C08 dark warm background so there is
        no white flash on startup.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/fitfudge_background</item>
        <item name="android:navigationBarColor">@color/fitfudge_background</item>
    </style>

    <!--
        NormalTheme is applied once the Flutter engine has drawn its first frame.
        Keeps the background consistent so there is no flash between launch
        and the Flutter UI appearing.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/fitfudge_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/fitfudge_background</item>
        <item name="android:navigationBarColor">@color/fitfudge_surface</item>
    </style>
</resources>
